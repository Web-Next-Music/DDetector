pragma ComponentBehavior: Bound
import QtQuick

// Decorative file-tree artwork: keep original Bearded colors; do not apply a tint.
Image {
    id: root
    property string fileName: ""
    property bool directory: false
    property bool expanded: false

    width: 14
    height: 14
    fillMode: Image.PreserveAspectFit
    source: sourceFor(fileName, directory, expanded)
    Accessible.ignored: true

    // Accepts a basename or slash/backslash-separated path. Names win over suffixes.
    function sourceFor(name, isDirectory, isExpanded) {
        if (isDirectory)
            return asset(isExpanded ? "_folder_open" : "_folder")
        var basename = String(name || "").replace(/\\/g, "/").split("/").pop().toLowerCase()
        if (Object.prototype.hasOwnProperty.call(nameIcons, basename))
            return asset(nameIcons[basename])
        var parts = basename.split(".")
        for (var i = 1; i < parts.length; ++i) {
            var suffix = parts.slice(i).join(".")
            if (Object.prototype.hasOwnProperty.call(extensionIcons, suffix))
                return asset(extensionIcons[suffix])
        }
        return asset("_file")
    }

    function asset(icon) {
        return "qrc:/assets/" + iconFiles[icon]
    }

